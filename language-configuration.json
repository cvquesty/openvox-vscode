{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(class|define|node)\\s",
      "end": "^\\s*}"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(class|define|node|if|else|elsif|unless|case|default|resource|exec).*\\{|\\{",
    "decreaseIndentPattern": "^\\s*\\}"
  }
}
